---
import { Image } from 'astro:assets';
import type { LegalApp } from '../lib/legal';

interface Props {
  app: Pick<LegalApp, 'slug' | 'name' | 'icon'>;
  size?: number;
}

const { app, size = 24 } = Astro.props;
// Apps without an icon file get a monogram in the KCT palette.
const radius = Math.round(size * 0.24);
---

{
  app.icon ? (
    <Image
      class="app-icon"
      src={app.icon}
      alt=""
      width={size}
      height={size}
      densities={[1, 2]}
      style={`border-radius:${radius}px`}
    />
  ) : (
    <span
      class="app-icon app-icon--monogram"
      aria-hidden="true"
      style={`width:${size}px;height:${size}px;border-radius:${radius}px;font-size:${Math.round(size * 0.48)}px`}
    >
      {app.name.charAt(0)}
    </span>
  )
}
